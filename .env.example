# GEMINI_API_KEY: Required for server-side Gemini Structured Outputs extraction.
# Inject via runtime environment secrets (never expose to client bundles).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public base URL where Cadence is hosted (OAuth origins and links).
APP_URL="http://localhost:3000"

# Optional Firebase Web SDK configuration when firebase-applet-config.json is omitted:
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
# VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
# VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"

